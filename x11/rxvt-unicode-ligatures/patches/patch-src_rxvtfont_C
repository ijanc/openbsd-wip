+#if HAVE_HARFBUZZ
+// open the matched font file directly with harfbuzz. glyph indices are
+// shared with xft, which lets us feed shaped glyphs into XftDrawGlyphSpec.
+void
+rxvt_font_xft::load_hb (FcPattern *match)
+{
+  FcChar8 *file;
+  int index = 0;
+  double pixelsize = 0;
+
+  if (FcPatternGetString (match, FC_FILE, 0, &file) != FcResultMatch)
+    return;
+
+  FcPatternGetInteger (match, FC_INDEX, 0, &index);
+  FcPatternGetDouble (match, FC_PIXEL_SIZE, 0, &pixelsize);
+
+  // bitmap fonts get scaled by xft, scale the shaper output the same way
+  double fixup;
+  if (FcPatternGetDouble (match, "pixelsizefixupfactor", 0, &fixup) == FcResultMatch)
+    pixelsize *= fixup;
+
+  hb_blob_t *blob = hb_blob_create_from_file ((const char *)file);
+
+  if (blob == hb_blob_get_empty ())
+    return;
+
+  hb_face_t *face = hb_face_create (blob, index & 0xffff);
+  hb_blob_destroy (blob);
+
+  hbf = hb_font_create (face);
+  hb_face_destroy (face);
+
+  int scale = (int)(pixelsize * 64. + .5);
+  hb_font_set_scale (hbf, scale, scale);
+
+  nfeatures = 0;
+
+  const char *spec = term->rs[Rs_fontFeatures];
+  if (!spec || !*spec)
+    spec = "liga,calt,dlig";
+
+  while (*spec && nfeatures < max_features)
+    {
+      const char *end = strchr (spec, ',');
+      int len = end ? end - spec : strlen (spec);
+
+      if (len && hb_feature_from_string (spec, len, &features [nfeatures]))
+        ++nfeatures;
+      else if (len)
+        rxvt_warn ("unable to parse font feature '%.*s', ignoring.\n", len, spec);
+
+      spec += end ? len + 1 : len;
+    }
 }
 
+bool
+rxvt_font_xft::shape (XftGlyphSpec *&ep, int x_, int y_, const text_t *text, int len)
+{
+  static hb_buffer_t *buf;
+
+  if (!buf)
+    buf = hb_buffer_create ();
+
+  hb_buffer_clear_contents (buf);
+
+  // cluster values are cell indices, NOCHAR cells belong to the preceding glyph
+  for (int i = 0; i < len; ++i)
+    if (text [i] != NOCHAR)
+      hb_buffer_add (buf, text [i], i);
+
+  hb_buffer_set_content_type (buf, HB_BUFFER_CONTENT_TYPE_UNICODE);
+  hb_buffer_guess_segment_properties (buf);
+  // the grid is always left to right
+  hb_buffer_set_direction (buf, HB_DIRECTION_LTR);
+
+  hb_shape (hbf, buf, features, nfeatures);
+
+  unsigned int n;
+  hb_glyph_info_t *info = hb_buffer_get_glyph_infos (buf, &n);
+  hb_glyph_position_t *pos = hb_buffer_get_glyph_positions (buf, 0);
+
+  dTermDisplay;
+
+  // advances come from xft so that shaped and unshaped text line up
+  // exactly, harfbuzz only contributes glyph ids and positioning offsets.
+  // rxvt_temp_buf is already in use by the caller for the glyph specs.
+  int xoff [n];
+
+  int ybase = y_ + term->fbase + (term->lineSpace >> 1);
+
+  for (unsigned int i = 0; i < n; )
+    {
+      unsigned int cluster = info [i].cluster;
+
+      // glyphs of one cluster are positioned as a group
+      unsigned int j = i;
+      int advance = 0;
+
+      while (j < n && info [j].cluster == cluster)
+        {
+          FT_UInt glyph = info [j].codepoint;
+
+          if (!glyph)
+            return false; // .notdef, let the per-character path handle it
+
+          XGlyphInfo extents;
+          XftGlyphExtents (disp, f, &glyph, 1, &extents);
+
+          xoff [j] = extents.xOff;
+          advance += extents.xOff;
+          ++j;
+        }
+
+      // cells covered by this cluster: up to the next cluster or end of run
+      int span = (j < n ? (int)info [j].cluster : len) - cluster;
+      int cwidth = term->fwidth * span;
+
+      if (text [cluster] != ' ')
+        {
+          int pen = x_ + term->fwidth * cluster;
+
+          // center within the covered cells, like the per-character path
+          pen += advance ? cwidth - advance >> 1 : 0;
+
+          for (; i < j; ++i)
+            {
+              ep->glyph = info [i].codepoint;
+              ep->x = pen + (pos [i].x_offset >> 6);
+              ep->y = ybase - (pos [i].y_offset >> 6);
+              ++ep;
+
+              pen += xoff [i];
+            }
+        }
+
+      i = j;
+    }
+
+  return true;
+}
